{
  "name": "resume-craft",
  "private": true,
  "version": "2.4.1",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.3 <13"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-og-card.mjs && vite build",
    "perf:report": "node scripts/check-performance-budget.mjs --report-only",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "rm -rf dist server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" vite.config.ts playwright.config.ts",
    "check:stable-deps": "node scripts/check-stable-dependencies.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:critical": "node node_modules/@typescript/native/bin/tsc -p tsconfig.strict-critical.json --noEmit",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" vite.config.ts playwright.config.ts --fix",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "dexie": "^4.2.1",
    "fflate": "^0.8.3",
    "html2canvas-pro": "^2.5.1",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-to-print": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
